// 💡 Approach --->

// Read the input expression as a string str.
// Remove all the + signs from the string using replace("+", "").
// Convert the remaining numbers into a character array using toCharArray().
// Sort the character array using Arrays.sort(arr).
// Initialize an empty string result.
// Traverse through the sorted array.
// Add each number to result.
// After every number except the last one, add a + sign.

import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String str = sc.nextLine();
        char[] arr=str.replace("+","").toCharArray();
        Arrays.sort(arr);
        String result="";
        for(int i =0;i<arr.length;i++){
            result+=arr[i];
            if(i<arr.length-1){
                result+="+";
            }
        }
        System.out.print(result);
    }
}
