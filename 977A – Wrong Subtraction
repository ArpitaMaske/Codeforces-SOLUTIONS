// 💡 Approach
// Read n and k.
// Run a loop exactly k times.
// Check whether the last digit of n is 0 using n % 10.
// If it is 0, divide n by 10.
// Otherwise, subtract 1 from n.
// Print the final value.

import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int k = sc.nextInt();
        for(int i = 1;i<=k;i++){
            if((n%10)==0){
                n = n/10;
            }else{
                n = n-1;
            }
        }
        System.out.print(n);
    }
}
